# A stack's settings, with the values of the local run (scripts/check-stack.sh).

# Names the stack's router in the proxy; unique per machine.
STACK_NAME=local
# The host name the site answers for.
APP_DOMAIN=localhost
# The app's image.
WEB_IMAGE=beds24-direct-booking-web:local
# The simulator's image; only read where the profile below is set.
SIM_IMAGE=beds24-direct-booking-sim:local
# "sim" starts the simulator beside the app. A site with a Beds24 account leaves it out.
COMPOSE_PROFILES=sim
# Where Beds24 is: the simulator here, https://api.beds24.com/v2 for a real account.
BEDS24_URL=http://sim:4300/v2
# The Beds24 token. Only the simulator's is not a secret.
BEDS24_TOKEN=simulator
# Search engines are kept out unless this is set to nothing: ROBOTS_TAG=
#ROBOTS_TAG=
